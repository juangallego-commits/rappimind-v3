{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "doc-page.js",
              "ui_kits/rappiads/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:PPObjectSans))/i]",
        "message": "Font not provided by the design system. Available: PPObjectSans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|variant|size|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: value, label, variant, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:neon|dark|gold|white)$/]",
        "message": "<Badge> variant must be one of 'neon' | 'dark' | 'gold' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BannerHome'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|cta|variant|logoSrc|key|ref|className|style|children)$/]",
        "message": "<BannerHome> doesn't accept that prop. Declared props: title, subtitle, cta, variant, logoSrc."
      },
      {
        "selector": "JSXOpeningElement[name.name='BannerHome'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:neon|turbo|pro)$/]",
        "message": "<BannerHome> variant must be one of 'neon' | 'turbo' | 'pro'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|variant|size|disabled|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: label, variant, size, disabled, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|dark|white)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'dark' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='InappCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|cta|badgeValue|imageSrc|variant|key|ref|className|style|children)$/]",
        "message": "<InappCard> doesn't accept that prop. Declared props: title, description, cta, badgeValue, imageSrc, variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='InappCard'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:neon|turbo|pro)$/]",
        "message": "<InappCard> variant must be one of 'neon' | 'turbo' | 'pro'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|variant|active|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: label, variant, active."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:neon|turbo|pro|neutral)$/]",
        "message": "<Tag> variant must be one of 'neon' | 'turbo' | 'pro' | 'neutral'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
